# Copie este arquivo para ".env" (nunca commitado) e ajuste os valores.
# Em desenvolvimento local, nenhuma destas variáveis é obrigatória — o
# settings/dev.py já roda com defaults seguros para uso local.

# Chave de assinatura de sessões/CSRF. Gere uma nova para produção com:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# "True" só em desenvolvimento. settings/prod.py ignora esta variável e
# força DEBUG=False sempre.
DJANGO_DEBUG=True

# Lista separada por vírgula. Obrigatório em produção (settings/prod.py
# não tem default). Exemplo para PythonAnywhere: meuusuario.pythonanywhere.com
DJANGO_ALLOWED_HOSTS=
